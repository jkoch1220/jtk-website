---
// Persönliches Element. Variante "panorama": lebendes, gerastertes Bergpanorama über die volle
// Breite. Es lässt sich mit der Maus anfassen und immer wieder neu zeichnen (Skript: berge-buehne.ts).
// Variante "foto": liegt ein Foto unter public/julian.jpg, erscheint es gerastert im
// Fenster; ohne Foto rendert die Variante nichts.
import { existsSync } from "node:fs";
import { join } from "node:path";
import Fenster from "./Fenster.astro";

interface Props {
  variante?: "panorama" | "foto";
}

const { variante = "panorama" } = Astro.props;

// Der Build läuft im Projektordner, daher relativ zu dessen Wurzel prüfen
const hatFoto = existsSync(join(process.cwd(), "public", "julian.jpg"));
---

{
  variante === "panorama" && (
    <div class="berge" data-berge-buehne>
      <div class="berge__bild" data-berge-bild data-gesehen="Berge: Bild gesehen">
        <canvas
          class="berge__gesamt"
          data-berge
          role="img"
          aria-label="Gezeichnete Berglandschaft mit Sonne, See und einem Wanderer am Gipfel"
        />
      </div>
      <div class="fenster berge__hud">
        <div class="fenster__titel" aria-hidden="true">
          <span class="fenster__titeltext">berge.bmp</span>
        </div>
        <div class="fenster__status">
          <span data-bild-groesse>6 Farben</span>
          <button type="button" class="leise-knopf leise-knopf--pixel" data-berge-neu>
            Neu zeichnen
          </button>
        </div>
      </div>
      <p class="sr-only" aria-live="polite" data-berge-ansage></p>
    </div>
  )
}
{
  variante === "foto" && hatFoto && (
    <Fenster titel="julian.jpg" class="bild-fenster">
      <canvas width="240" height="300" data-foto="/julian.jpg" role="img" aria-label="Foto von Julian Koch, gerastert" />
      <Fragment slot="status">
        <span>Julian Koch</span>
        <span data-bild-groesse>2 Farben</span>
      </Fragment>
    </Fenster>
  )
}

<style is:global>
  /* Bergpanorama --------------------------------------------------------------
     Volle Breite von .panorama, keine eigenen Außenabstände. Oben reines Weiß
     (Naht zum weißen Band), unten exakt --tinte-nacht (Naht zur Rasterkante). */

  .berge {
    position: relative;
    isolation: isolate;
  }

  .berge__bild {
    position: relative;
    overflow: hidden;
    height: 70vw;
    background: var(--bogen);
  }

  /* Groß wie ein Ausblick: bis knapp unter die Kopfzeile, auch bei 2560 px nicht gedeckelt.
     Im Querformat auf dem Handy passt das Bild ganz unter die Kopfzeile. */
  @media (min-width: 768px) {
    .berge__bild {
      height: clamp(440px, 46vw, 1240px);
      max-height: max(260px, calc(100svh - var(--kopf-hoehe, 72px) - 24px));
    }
  }

  /* Breite, Höhe und left setzt das Skript in ganzen Kunstpixeln. Die Pixel lassen sich
     anfassen: Senkrecht scrollt der Finger weiter, waagerecht schiebt er die Pixel. */
  .berge__gesamt {
    position: absolute;
    bottom: 0;
    display: block;
    image-rendering: pixelated;
    cursor: crosshair;
    touch-action: pan-y;
    -webkit-user-select: none;
    user-select: none;
  }

  .berge__hud .fenster__status {
    padding-block: 0;
  }

  .berge__hud [data-bild-groesse] {
    font-variant-numeric: tabular-nums;
  }

  /* Tippziel mindestens 44 px */
  .berge__hud [data-berge-neu] {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  @media (min-width: 768px) {
    .berge__hud {
      position: absolute;
      top: clamp(20px, 3vw, 48px);
      right: var(--satz-einzug, max(var(--rand), (100vw - 1328px) / 2));
      z-index: 2;
      width: 300px;
      box-shadow: var(--e-retro-tief, 6px 6px 0 var(--tinte));
    }
  }

  /* Mobil: Titelleiste über dem Bild, Statusleiste darunter. Die Statusleiste
     läuft in Nacht-Tinte weiter, so bleibt die Naht zur Rasterkante ruhig. */
  @media (max-width: 767px) {
    .berge {
      display: flex;
      flex-direction: column;
    }

    .berge__hud {
      display: contents;
    }

    .berge__hud .fenster__titel {
      order: -1;
    }

    .berge__hud .fenster__status {
      order: 1;
      border-top: 0;
      background: var(--tinte-nacht);
      color: var(--auf-nacht-matt);
      --fokus: var(--auf-nacht);
    }

    .berge__hud .leise-knopf.leise-knopf--pixel {
      color: var(--auf-nacht);
      text-decoration-color: var(--auf-nacht-unterstrich);
    }

    .berge__hud [data-berge-neu]:focus-visible {
      outline: 2px solid var(--auf-nacht);
      outline-offset: 2px;
    }
  }

  /* Druck: das ganze Bild in voller Breite und auf einer Seite, auch wenn der zeilenweise Auftritt noch
     nicht lief. Das Seitenverhältnis kommt aus den Kunstpixeln des Canvas; HUD und Knopf bleiben weg. */
  @media print {
    .berge {
      break-inside: avoid;
    }

    .berge__bild {
      height: auto;
      max-height: none;
      clip-path: none !important;
      break-inside: avoid;
    }

    .berge__gesamt {
      position: static;
      width: 100% !important;
      height: auto !important;
    }

    .berge__hud {
      display: none;
    }
  }
</style>
