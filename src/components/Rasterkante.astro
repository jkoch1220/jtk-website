---
// Naht zwischen hellem und dunklem Band: gerasterter Übergang in Kunstpixeln,
// dieselbe Bayer-Matrix wie im Bergbild. Die Kachel entsteht beim Bauen als SVG.
interface Props {
  von: string;
  nach: string;
}

const { von, nach } = Astro.props;

const BAYER = [
  [0, 32, 8, 40, 2, 34, 10, 42],
  [48, 16, 56, 24, 50, 18, 58, 26],
  [12, 44, 4, 36, 14, 46, 6, 38],
  [60, 28, 52, 20, 62, 30, 54, 22],
  [3, 35, 11, 43, 1, 33, 9, 41],
  [51, 19, 59, 27, 49, 17, 57, 25],
  [15, 47, 7, 39, 13, 45, 5, 37],
  [63, 31, 55, 23, 61, 29, 53, 21],
];

const zellen: string[] = [];
for (let y = 0; y < 16; y++) {
  const dichte = (y + 0.5) / 16;
  for (let x = 0; x < 8; x++) {
    if (dichte > (BAYER[y % 8][x % 8] + 0.5) / 64) zellen.push(`<rect x="${x}" y="${y}" width="1" height="1"/>`);
  }
}
const svg =
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 8 16" width="8" height="16" shape-rendering="crispEdges">` +
  `<rect width="8" height="16" fill="${von}"/><g fill="${nach}">${zellen.join("")}</g></svg>`;
const kachel = `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
---

<div class="rasterkante voll" aria-hidden="true" style={`--kachel: ${kachel}`}></div>
