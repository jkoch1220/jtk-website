---
const links = [
  { href: "/#check", text: "Zeitfresser-Check" },
  { href: "/#leistungen", text: "Ihr Betrieb danach" },
  { href: "/#ueber-mich", text: "Ihr Ansprechpartner" },
  { href: "/#ablauf", text: "Ihr Weg" },
];
---

<header class="kopf">
  <div class="innen kopf__innen">
    <a class="marke" href="/"><strong>JTK</strong> Consulting</a>
    <nav class="kopf__nav" aria-label="Hauptnavigation">
      <ul>
        {
          links.map((link) => (
            <li class="nav-optional">
              <a href={link.href}>{link.text}</a>
            </li>
          ))
        }
        <li>
          <a class="kopf__kontakt" href="/#kontakt">
            Erstgespräch<span class="kopf__lang">&nbsp;vereinbaren</span>
          </a>
        </li>
      </ul>
    </nav>
    {/* hidden: klang.ts schaltet frei, wenn der Browser Ton erzeugen kann. Ohne Skript verspricht der
        Knopf nichts. Gedrückt = Ton an: Schallbögen statt Kreuz. */}
    <button type="button" class="ton-schalter" data-ton-schalter aria-pressed="false" hidden>
      <span class="sr-only">Ton</span>
      <svg class="ton-symbol" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
        <path d="M1 4h3v4H1zM4 3h1v6H4zM5 2h1v8H5zM6 1h1v10H6z" />
        <path
          class="ton-symbol__wellen"
          d="M8 4h1v1H8zM9 5h1v2H9zM8 7h1v1H8zM9 2h1v1H9zM10 3h1v1h-1zM11 4h1v4h-1zM10 8h1v1h-1zM9 9h1v1H9z"
        />
        <path class="ton-symbol__aus" d="M8 4h1v1H8zM11 4h1v1h-1zM9 5h2v2H9zM8 7h1v1H8zM11 7h1v1h-1z" />
      </svg>
    </button>
    <button type="button" class="modus-schalter" data-modus-schalter aria-pressed="false">
      <span class="sr-only">Dunkelmodus</span>
      <svg viewBox="0 0 12 12" aria-hidden="true" focusable="false">
        <path d="M3 1h2v1H3zM2 2h2v1H2zM1 3h3v3H1zM1 6h4v1H1zM1 7h5v1H1zM1 8h7v1H1zM10 8h1v1h-1zM2 9h8v1H2zM3 10h6v1H3z" />
        <path class="modus-schalter__sterne" d="M9 1h1v1H9zM8 2h3v1H8zM9 3h1v1H9zM11 5h1v1h-1z" />
      </svg>
    </button>
  </div>
</header>
