---
import { kontakt } from "../data/kontakt";
const jahr = new Date().getFullYear();
---

<footer class="fuss">
  <div class="kontrollstreifen" aria-hidden="true"></div>
  <div class="innen fuss__satz">
    <div class="fuss__innen">
      <p>© {jahr} {kontakt.firma}, {kontakt.ort}</p>
      <ul class="fuss__links">
        <li><a href="/impressum/">Impressum</a></li>
        <li><a href="/datenschutz/">Datenschutz</a></li>
      </ul>
    </div>
  </div>
  <p class="fuss__marke" aria-hidden="true"><strong>JTK</strong> Consulting</p>
</footer>
