---
import { kontakt, mailBetreff } from "../data/kontakt";

const punkte = [
  "Anfragen aus E-Mails in Listen übertragen",
  "Angebote aus alten Vorlagen zusammenkopieren",
  "Aufträge per Hand an Lieferanten weitergeben",
  "Lieferscheine und Rechnungen abtippen",
  "Die E-Rechnung einführen (Pflicht ab 2027 bzw. 2028)",
  "Excel-Listen pflegen, die nur eine Person versteht",
  "Daten zwischen zwei Programmen hin- und herkopieren",
  "Dieselben Kundenfragen jeden Tag neu beantworten",
];
---

<section class="abschnitt checkliste" id="handarbeit" aria-labelledby="checkliste-titel">
  <div class="innen raster">
    <div class="abschnitt__kopf">
      <h2 id="checkliste-titel">Was läuft bei Ihnen noch von Hand?</h2>
      <p>Kreuzen Sie an, was auf Ihren Betrieb zutrifft. Daraus entsteht eine fertige E-Mail an mich.</p>
    </div>

    <form
      class="abschnitt__inhalt"
      data-checkliste
      data-email={kontakt.email}
      data-betreff={mailBetreff}
      novalidate
    >
      <fieldset>
        <legend class="sr-only">Abläufe, die in Ihrem Betrieb noch von Hand laufen</legend>
        <ul class="checkliste__liste">
          {
            punkte.map((punkt, i) => (
              <li>
                <input class="checkliste__box" type="checkbox" id={`punkt-${i + 1}`} name="punkt" value={punkt} />
                <label for={`punkt-${i + 1}`}>
                  <span class="kreuz" aria-hidden="true">
                    <svg viewBox="0 0 20 20">
                      <path d="M4 4 L16 16" />
                      <path d="M16 4 L4 16" />
                    </svg>
                  </span>
                  <span>{punkt}</span>
                </label>
              </li>
            ))
          }
        </ul>
      </fieldset>

      <div class="checkliste__fuss">
        <p class="checkliste__stand" data-stand aria-live="polite">Noch nichts angekreuzt</p>
        <div class="checkliste__aktionen">
          <a class="knopf knopf--voll" href={`mailto:${kontakt.email}`} data-senden aria-disabled="true"
            >Liste per E-Mail senden</a
          >
          <button class="knopf" type="button" data-kopieren disabled>Text kopieren</button>
        </div>
      </div>
      <label class="sr-only" for="checkliste-text">E-Mail-Text zum Kopieren</label>
      <textarea class="checkliste__text" id="checkliste-text" data-text readonly hidden></textarea>
    </form>
  </div>
</section>
