---
// StoryBrand: weicher Handlungsaufruf. Der Besucher trägt Mengen ein, die er kennt (Anfragen pro
// Woche, Rechnungen pro Monat …), der Check rechnet mit sichtbaren, vorsichtigen Richtwerten Stunden,
// Stellen und Euro pro Jahr aus, dazu den Umsatz, der durchrutscht. Die größten Posten zeigen den
// Startpunkt, das Ergebnis geht ans Anfrageformular.
import Fenster from "./Fenster.astro";

type Einheit = "Tag" | "Woche" | "Monat";

// minuten: Richtwert je Vorgang, lässt sich unter „Richtwerte anpassen“ ändern.
// Bei „touren“ trägt der Besucher direkt Stunden ein, daher fest 60 Minuten.
const posten: {
  id: string;
  aufgabe: string;
  tipp: string;
  einheit: Einheit;
  minuten: number;
  je?: string;
  einheitText?: string;
  schritt: string;
}[] = [
  {
    id: "anfragen",
    aufgabe: "Anfragen erfassen und beantworten",
    tipp: "Ein Blick ins Postfach der letzten Woche reicht.",
    einheit: "Woche",
    minuten: 10,
    je: "Anfrage",
    schritt: "Sie bekommen jede Anfrage direkt ins System, ob per Mail, Formular oder Telefon, und antworten in Minuten.",
  },
  {
    id: "angebote",
    aufgabe: "Angebote schreiben",
    tipp: "Ihre Angebotsnummern verraten es.",
    einheit: "Woche",
    minuten: 20,
    je: "Angebot",
    schritt: "Sie stellen Angebote mit wenigen Klicks aus Ihren Artikeln und Preisen zusammen statt aus alten Kopien.",
  },
  {
    id: "anrufe",
    aufgabe: "Routineanrufe annehmen und weiterverbinden",
    tipp: "Etwa „Wann kommt meine Lieferung?“. Ihre Telefonanlage zeigt alle Anrufe.",
    einheit: "Tag",
    minuten: 3,
    je: "Anruf",
    schritt: "Sie lassen Routineanrufe von einem KI-Telefonassistenten beantworten. Was Ihr Team braucht, landet weiter bei Ihrem Team.",
  },
  {
    id: "rechnungen",
    aufgabe: "Rechnungen schreiben und verschicken",
    tipp: "Die Rechnungsnummern des letzten Monats.",
    einheit: "Monat",
    minuten: 5,
    je: "Rechnung",
    schritt: "Sie bekommen Rechnung und E-Rechnung direkt aus dem Auftrag, ohne etwas neu zu tippen.",
  },
  {
    id: "zahlungen",
    aufgabe: "Zahlungseingänge zuordnen und mahnen",
    tipp: "So viele Zahlungen, wie Sie im Monat erwarten.",
    einheit: "Monat",
    minuten: 3,
    je: "Zahlung",
    schritt: "Sie sehen jede Zahlung automatisch ihrer Rechnung zugeordnet, Erinnerungen gehen von selbst raus.",
  },
  {
    id: "eingang",
    aufgabe: "Eingangsrechnungen erfassen und prüfen",
    tipp: "Die Belege, die im Monat bei Ihnen ankommen.",
    einheit: "Monat",
    minuten: 5,
    je: "Beleg",
    schritt: "Sie geben Eingangsrechnungen nur noch frei. Erfassen und Weitergeben an die Buchhaltung übernimmt das System.",
  },
  {
    id: "bestellungen",
    aufgabe: "Bestellungen an Lieferanten weitergeben",
    tipp: "Wie oft Sie pro Woche bestellen.",
    einheit: "Woche",
    minuten: 10,
    je: "Bestellung",
    schritt: "Sie geben den Auftrag frei, und die Bestellung geht automatisch an den Lieferanten.",
  },
  {
    id: "touren",
    aufgabe: "Touren und Einsätze planen",
    tipp: "Bei Saisongeschäft den Durchschnitt übers Jahr.",
    einheit: "Woche",
    minuten: 60,
    einheitText: "Std. pro Woche",
    schritt: "Sie planen Touren halbautomatisch: Das System schlägt Route und Fahrzeug vor, Sie entscheiden.",
  },
];

// quote: von so vielen wird einer zum Auftrag, bewusst vorsichtig angesetzt
const durchrutscher: {
  id: string;
  aufgabe: string;
  tipp: string;
  kurz: string;
  einheit: Einheit;
  quote: number;
  satz: [string, string];
  frage: string;
  schritt: string;
}[] = [
  {
    id: "verpasst",
    aufgabe: "Verpasste Anrufe",
    kurz: "verpasste Anrufe",
    tipp: "Stehen in der Anrufliste Ihrer Telefonanlage.",
    einheit: "Woche",
    quote: 20,
    satz: ["Von", "verpassten Anrufen wäre einer ein Auftrag geworden"],
    frage: "Von wie vielen verpassten Anrufen wäre einer ein Auftrag geworden?",
    schritt: "Sie verpassen keinen Anruf mehr: Ein KI-Telefonassistent nimmt jeden an, auch nach Feierabend, und legt neue Anfragen im System an.",
  },
  {
    id: "nachfassen",
    aufgabe: "Angebote, bei denen niemand nachfasst",
    kurz: "Angebote ohne Nachfassen",
    tipp: "Offene Angebote, die älter als zwei Wochen sind.",
    einheit: "Monat",
    quote: 10,
    satz: ["Von", "nachgefassten Angeboten wird eines zum Auftrag"],
    frage: "Von wie vielen nachgefassten Angeboten wird eines zum Auftrag?",
    schritt: "Sie sehen offene Angebote auf einen Blick und fassen rechtzeitig nach, das System erinnert Sie.",
  },
];

const einheitText = { Tag: "pro Tag", Woche: "pro Woche", Monat: "pro Monat" };
---

<section class="abschnitt check" id="check" aria-labelledby="check-titel">
  <div class="innen raster">
    <div class="abschnitt__kopf">
      <h2 id="check-titel">Was kostet Sie die Handarbeit?</h2>
      <p>
        Der Zeitfresser-Check dauert zwei Minuten. Tragen Sie ein, wie oft etwas bei Ihnen anfällt. Das wissen Sie
        besser als jeder Berater. Der Check rechnet mit vorsichtigen Richtwerten und zeigt Ihnen, was Sie das im
        Jahr kostet, was Ihnen an Umsatz durchrutscht und wo Sie anfangen können.
      </p>
    </div>

    <Fenster titel="Zeitfresser-Check" class="abschnitt__inhalt check__fenster">
      <form data-check novalidate>
        <fieldset class="check__gruppe">
          <legend>Wie oft fällt das bei Ihnen an?</legend>
          <p class="check__hinweis">Tragen Sie ein, was Sie kennen. Leere Felder zählen nicht mit.</p>
          <ul class="posten">
            {
              posten.map((p) => (
                <li class="posten__zeile">
                  <label class="posten__aufgabe" for={`menge-${p.id}`}>
                    {p.aufgabe}
                  </label>
                  <p class="posten__tipp" id={`tipp-${p.id}`}>
                    {p.tipp}
                  </p>
                  <div class="posten__eingabe">
                    <input
                      class="posten__zahl"
                      id={`menge-${p.id}`}
                      type="text"
                      inputmode="numeric"
                      autocomplete="off"
                      maxlength="5"
                      placeholder="0"
                      aria-describedby={`tipp-${p.id}`}
                      data-menge={p.id}
                      data-aufgabe={p.aufgabe}
                      data-einheit={p.einheit}
                      data-minuten={p.minuten}
                      data-je={p.je}
                      data-einheit-text={p.einheitText ?? einheitText[p.einheit]}
                      data-schritt={p.schritt}
                    />
                    <span class="posten__einheit">{p.einheitText ?? einheitText[p.einheit]}</span>
                  </div>
                </li>
              ))
            }
          </ul>
        </fieldset>

        <fieldset class="check__gruppe">
          <legend>Was Ihnen durchrutscht</legend>
          <p class="check__hinweis">Hier geht es nicht um Zeit, sondern um Aufträge, die gar nicht erst entstehen.</p>
          <ul class="posten">
            {
              durchrutscher.map((d) => (
                <li class="posten__zeile">
                  <label class="posten__aufgabe" for={`menge-${d.id}`}>
                    {d.aufgabe}
                  </label>
                  <p class="posten__tipp" id={`tipp-${d.id}`}>
                    {d.tipp}
                  </p>
                  <div class="posten__eingabe">
                    <input
                      class="posten__zahl"
                      id={`menge-${d.id}`}
                      type="text"
                      inputmode="numeric"
                      autocomplete="off"
                      maxlength="5"
                      placeholder="0"
                      aria-describedby={`tipp-${d.id}`}
                      data-verlust={d.id}
                      data-aufgabe={d.aufgabe}
                      data-einheit={d.einheit}
                      data-quote={d.quote}
                      data-kurz={d.kurz}
                      data-einheit-text={einheitText[d.einheit]}
                      data-schritt={d.schritt}
                    />
                    <span class="posten__einheit">{einheitText[d.einheit]}</span>
                  </div>
                </li>
              ))
            }
            <li class="posten__zeile">
              <label class="posten__aufgabe" for="auftragswert">Durchschnittlicher Auftragswert</label>
              <p class="posten__tipp" id="tipp-auftragswert">Grob reicht, zum Beispiel 2.500.</p>
              <div class="posten__eingabe">
                <input
                  class="posten__zahl posten__zahl--breit"
                  id="auftragswert"
                  type="text"
                  inputmode="numeric"
                  autocomplete="off"
                  maxlength="9"
                  placeholder="0"
                  aria-describedby="tipp-auftragswert"
                  data-auftragswert
                />
                <span class="posten__einheit">Euro</span>
              </div>
            </li>
          </ul>
        </fieldset>

        <details class="check__richtwerte">
          <summary>Richtwerte ansehen und anpassen</summary>
          <p class="check__hinweis">
            Gerechnet wird vorsichtig. Wenn es bei Ihnen länger dauert, tragen Sie Ihren eigenen Wert ein.
          </p>
          <ul class="richtwerte">
            {
              posten
                .filter((p) => p.je)
                .map((p) => (
                  <li>
                    <label for={`richtwert-${p.id}`}>Minuten je {p.je}</label>
                    <input
                      class="posten__zahl"
                      id={`richtwert-${p.id}`}
                      type="text"
                      inputmode="numeric"
                      autocomplete="off"
                      maxlength="3"
                      value={p.minuten}
                      data-richtwert={p.id}
                      data-standard={p.minuten}
                    />
                  </li>
                ))
            }
            {
              durchrutscher.map((d) => (
                <li class="richtwerte__satz">
                  <span aria-hidden="true">{d.satz[0]}</span>
                  <input
                    class="posten__zahl"
                    type="text"
                    inputmode="numeric"
                    autocomplete="off"
                    maxlength="3"
                    value={d.quote}
                    aria-label={d.frage}
                    data-quote-fuer={d.id}
                    data-standard={d.quote}
                  />
                  <span aria-hidden="true">{d.satz[1]}</span>
                </li>
              ))
            }
          </ul>
        </details>

        <div class="check__ergebnis" aria-live="polite">
          <p class="check__zahl" data-ergebnis-zahl>Ihr Ergebnis erscheint hier</p>
          <p class="check__erklaerung" data-ergebnis-text>
            Zum Vergleich: 30 Minuten am Tag sind rund 110 Stunden im Jahr.
          </p>
          <p class="check__umsatz" data-ergebnis-umsatz hidden></p>
          <div class="check__schritte" data-ergebnis-schritte hidden>
            <p class="check__schritte-titel">Ihre größten Hebel</p>
            <ul data-ergebnis-liste></ul>
          </div>
        </div>

        <div class="check__aktionen">
          <button type="button" class="retro-knopf retro-knopf--voll" data-check-besprechen disabled>
            Meinen Startpunkt besprechen
          </button>
        </div>
      </form>

      <Fragment slot="status">
        <span data-check-stand>Noch nichts eingetragen</span>
        <span>Gerechnet mit 220 Arbeitstagen und 45 € pro Stunde</span>
      </Fragment>
    </Fenster>
  </div>
</section>
