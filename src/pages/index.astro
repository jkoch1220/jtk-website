---
// Aufbau nach StoryBrand (siehe docs/brandscript.md):
// Der Besucher ist der Held: Kopf mit seinem Wunsch, Problem (außen, innen, grundsätzlich) und
// Folgen, weicher Handlungsaufruf (Check), Erfolg und Wandel, Begleiter (Empathie und Erfahrung),
// Plan mit Zusagen, direkter Handlungsaufruf.
import Base from "../layouts/Base.astro";
import Beleg from "../components/Beleg.astro";
import Problem from "../components/Problem.astro";
import Zeitfresser from "../components/Zeitfresser.astro";
import Persoenlich from "../components/Persoenlich.astro";
import Anfrage from "../components/Anfrage.astro";
import Rand from "../components/Rand.astro";
import Rasterkante from "../components/Rasterkante.astro";
import Praxis from "../components/praxis/Praxis.astro";
import { kontakt } from "../data/kontakt";
import { erfolge, schritte } from "../data/zusagen";

---

<Base
  title="IT-Beratung & Software in Düsseldorf | JTK Consulting"
  description="IT-Beratung und Software in Düsseldorf: Sie wachsen, ohne dass Ihr Büro mitwächst, auch mit Ihren alten Programmen. Festpreis je Etappe, Erstgespräch kostenlos."
  startseite
>
  <section class="hero" aria-labelledby="hero-titel">
    <div class="bogen band--papier">
      <Rand nr="01" titel="JTK Consulting" />
      <div class="satz hero__satz">
        <div class="hero__text">
          <h1 id="hero-titel">
            <span class="hero__dach">IT-Beratung und Software in Düsseldorf<span class="sr-only">:</span></span>{" "}
            Wachsen Sie, ohne dass Ihr Büro mitwachsen muss.
          </h1>
          <p class="hero__lead">
            Sie haben einen Betrieb aufgebaut, der funktioniert. Mit Software, die Ihnen Anfragen, Angebote und Rechnungen
            abnimmt, bringen Sie ihn weiter, auch mit Ihren alten Programmen.
          </p>
          <div class="hero__aktionen">
            <a class="knopf knopf--voll" href="#kontakt">Kostenloses Erstgespräch vereinbaren</a>
            <a class="knopf" href="#check">Zeitfresser-Check machen</a>
          </div>
          <p class="hero__telefon">
            Oder direkt anrufen: <a href={kontakt.telefonLink}>{kontakt.telefonAnzeige}</a>
          </p>
        </div>
        <Beleg />
      </div>
      <Rasterkante von="papier" nach="nacht" />
    </div>
  </section>

  <Problem />

  <Zeitfresser />

  <section class="leistungen-abschnitt" id="leistungen" aria-labelledby="leistungen-titel">
    <div class="bogen band--bogen">
      <Rand nr="04" titel="Ihr Betrieb danach" />
      <div class="satz">
        <div class="leistungen__kopf">
          <p class="kicker" aria-hidden="true">04 · Ihr Betrieb danach</p>
          <h2 id="leistungen-titel">So läuft Ihr Betrieb danach</h2>
          <p>
            Sie nehmen mehr Aufträge an, ohne dass das Büro mitwächst. Ihr Team hat wieder Zeit für Kunden, und Sie sehen
            jederzeit, wo Ihr Betrieb steht, ohne nachzufragen.
          </p>
        </div>
        <dl class="leistungen">
          {
            erfolge.map((e) => (
              <div id={`zusage-${e.id}`}>
                <dt>{e.titel}</dt>
                <dd>{e.text}</dd>
              </div>
            ))
          }
        </dl>
        <p class="leistungen__wandel">
          Aus dem Betrieb, den das Büro ausbremst, wird einer, der mit der Zeit geht. Und Sie sind wieder Unternehmer
          statt Sachbearbeiter im eigenen Betrieb.
        </p>
        <p class="leistungen__fuss">
          Dafür setze ich individuelle Software, ERP- und CRM-Systeme, Schnittstellen, KI-Automationen und
          KI-Telefonassistenten um.
        </p>
      </div>
    </div>
  </section>

  <section class="begleiter" id="ueber-mich" aria-labelledby="ueber-titel">
    <div class="bogen band--bogen ueber-band">
      <Rand nr="05" titel="Ihr Ansprechpartner" />
      <div class="satz">
        <p class="kicker" aria-hidden="true">05 · Ihr Ansprechpartner</p>
        <h2 id="ueber-titel">Sie brauchen jemanden, der Ihren Alltag kennt</h2>
      </div>
      <div class="panorama voll">
        <Persoenlich />
      </div>
      <Rasterkante von="nacht" nach="papier" />
    </div>
    <div class="bogen band--papier ueber-unten">
      <div class="satz">
        <article class="ueber-bogen ueber">
          <Persoenlich variante="foto" />
          <p>
            Ich weiß, wie es ist, wenn das Büro den Betrieb ausbremst. Bei der Tennismehl GmbH bin ich Mitgesellschafter
            und führe die Geschäfte. Ich erlebe also jeden Tag, wo im Mittelstand Zeit verloren geht, von der
            Lohnabrechnung bis zur Tourenplanung. Genau diese Abläufe automatisiere ich, für mein eigenes Unternehmen und
            für Ihres.
          </p>
          <p>
            Ich bin Julian Koch, IT-Berater aus Düsseldorf für digitale Abläufe. JTK steht für meinen vollen
            Namen, {kontakt.nameVoll}. Ich habe große Digitalprojekte für Konzerne mitentwickelt und als
            Vertriebsingenieur Automatisierungstechnik in die Industrie gebracht. Heute bin ich selbst Unternehmer.
          </p>
          <p>
            Sie bekommen also Konzern-Erfahrung von jemandem, der rechnet wie ein Mittelständler. Sie haben einen
            Ansprechpartner vom ersten Gespräch bis zur fertigen Lösung. Und Sie hängen trotzdem nie an mir: Code,
            Zugänge und Dokumentation gehören Ihnen.
          </p>
          <p class="ueber__privat">Ausgleich finde ich in den Bergen.</p>
        </article>
      </div>
    </div>
  </section>

  <Praxis />

  <section class="ablauf-abschnitt" id="ablauf" aria-labelledby="ablauf-titel">
    <div class="bogen band--papier ablauf-band">
      <Rand nr="07" titel="Ihr Weg" />
      <div class="satz">
        <p class="kicker" aria-hidden="true">07 · Ihr Weg</p>
        <h2 id="ablauf-titel">In drei Schritten zu weniger Büroarbeit</h2>
      </div>
      <div class="ablauf__linie voll" aria-hidden="true">
        <svg class="ablauf__pfeil ablauf__pfeil--l" viewBox="0 0 10 16" focusable="false"><path d="M10 1 2 8l8 7" /></svg>
        <svg class="ablauf__strich" viewBox="0 0 100 16" preserveAspectRatio="none" focusable="false">
          <line x1="0" y1="8" x2="100" y2="8" vector-effect="non-scaling-stroke" />
        </svg>
        <svg class="ablauf__pfeil ablauf__pfeil--r" viewBox="0 0 10 16" focusable="false"><path d="M0 1l8 7-8 7" /></svg>
      </div>
      <ol class="ablauf">
        {
          schritte.map((s) => (
            <li id={`zusage-${s.id}`}>
              <h3>{s.titel}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="satz ablauf__fuss">
        <div class="ablauf__zusage">
          <span class="zusage__kopie zusage__kopie--rosa" aria-hidden="true"></span>
          <span class="zusage__kopie zusage__kopie--gelb" aria-hidden="true"></span>
          <p>
            Kein Großprojekt, das nie fertig wird. Ihre alten Programme dürfen bleiben, wenn sie ihren Dienst tun. Und
            Code, Zugänge und Dokumentation gehören Ihnen, ein anderer Entwickler kann jederzeit übernehmen.
          </p>
          <a class="knopf knopf--voll" href="#kontakt">Kostenloses Erstgespräch vereinbaren</a>
        </div>
      </div>
      <Rasterkante von="papier" nach="nacht-oben" />
    </div>
  </section>

  <Anfrage />
</Base>
