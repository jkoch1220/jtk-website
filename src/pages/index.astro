---
// Aufbau nach StoryBrand (siehe docs/brandscript.md):
// Kopf mit klarem Angebot, Problem und Folgen, weicher Handlungsaufruf (Check),
// Erfolg, Begleiter (Empathie und Erfahrung), Plan, direkter Handlungsaufruf.
import Base from "../layouts/Base.astro";
import Beleg from "../components/Beleg.astro";
import Problem from "../components/Problem.astro";
import Zeitfresser from "../components/Zeitfresser.astro";
import Persoenlich from "../components/Persoenlich.astro";
import Anfrage from "../components/Anfrage.astro";
import { kontakt } from "../data/kontakt";

const erfolge = [
  {
    titel: "Anfragen landen direkt im System",
    text: "Keine E-Mail geht mehr unter. Aus jeder Anfrage wird mit wenigen Klicks ein Angebot.",
  },
  {
    titel: "Rechnungen schreiben sich selbst",
    text: "Aus dem Auftrag entsteht die Rechnung und geht als E-Rechnung raus, so wie es ab 2027 bzw. 2028 Pflicht ist.",
  },
  {
    titel: "Ihre Programme sprechen miteinander",
    text: "Shop, Warenwirtschaft und Buchhaltung tauschen Daten selbst aus. Auch alte Programme bekommen Anschluss.",
  },
  {
    titel: "Routine übernimmt die KI",
    text: "E-Mails vorsortieren, Dokumente auslesen, Antworten vorbereiten. Was rausgeht, entscheiden Sie.",
  },
];

const schritte = [
  {
    titel: "Erstgespräch vereinbaren",
    text: "30 Minuten am Telefon oder bei Ihnen vor Ort. Wir klären, wo Ihr Betrieb Zeit verliert.",
  },
  {
    titel: "Plan mit Preis erhalten",
    text: "Ich schaue mir Ihre Abläufe an und zeige, was sich lohnt. Sie kennen Aufwand und Preis, bevor es losgeht.",
  },
  {
    titel: "Zeit zurückgewinnen",
    text: "Ich setze in Etappen um und schule Ihr Team. Danach bleibe ich für Wartung und Weiterentwicklung ansprechbar.",
  },
];
---

<Base
  title="JTK Consulting | Software und Prozessautomatisierung für den Mittelstand"
  description="Software, die Ihrem Betrieb die Büroarbeit abnimmt: Anfragen, Angebote, Rechnungen und E-Rechnung laufen von selbst, auch mit alten Programmen. Julian Koch, Düsseldorf."
  startseite
>
  <section class="hero" aria-labelledby="hero-titel">
    <div class="innen raster">
      <div class="hero__text">
        <h1 id="hero-titel">Software, die Ihrem Betrieb die Büroarbeit abnimmt.</h1>
        <p class="hero__lead">
          Anfragen, Angebote und Rechnungen laufen von selbst, auch mit Ihren alten Programmen. Für mittelständische
          Unternehmen in NRW.
        </p>
        <div class="hero__aktionen">
          <a class="knopf knopf--voll" href="#kontakt">Erstgespräch vereinbaren</a>
          <a class="knopf" href="#check">Zeitfresser-Check machen</a>
        </div>
        <p class="hero__telefon">
          Oder direkt anrufen: <a href={kontakt.telefonLink}>{kontakt.telefonAnzeige}</a>
        </p>
      </div>
      <Beleg />
    </div>
  </section>

  <Problem />

  <Zeitfresser />

  <section class="abschnitt" id="leistungen" aria-labelledby="leistungen-titel">
    <div class="innen raster">
      <div class="abschnitt__kopf">
        <h2 id="leistungen-titel">So läuft es danach</h2>
        <p>Ihr Team hat wieder Zeit für Kunden, und Sie haben jederzeit den Überblick.</p>
      </div>
      <div class="abschnitt__inhalt">
        <dl class="leistungen">
          {
            erfolge.map((e) => (
              <div>
                <dt>{e.titel}</dt>
                <dd>{e.text}</dd>
              </div>
            ))
          }
        </dl>
        <p class="leistungen__fuss">
          Dafür baue ich individuelle Software, ERP- und CRM-Systeme, Schnittstellen und KI-Automationen.
        </p>
      </div>
    </div>
  </section>

  <section class="abschnitt begleiter" id="ueber-mich" aria-labelledby="ueber-titel">
    <div class="innen raster">
      <div class="abschnitt__kopf">
        <h2 id="ueber-titel">Ich kenne das Problem von innen</h2>
        <div class="begleiter__bild">
          <Persoenlich />
        </div>
      </div>
      <div class="abschnitt__inhalt ueber">
        <p>
          Als Mitgesellschafter der Tennismehl GmbH erlebe ich jeden Tag, wo im Mittelstand Zeit verloren geht, von
          der Lohnabrechnung bis zur Tourenplanung. Genau diese Abläufe automatisiere ich, für mein eigenes
          Unternehmen und für Ihres.
        </p>
        <p>
          Ich bin Julian Koch, Fachinformatiker für Anwendungsentwicklung. Bei Cognex war ich Software-Architekt und
          Sales Engineer für industrielle Bildverarbeitung. Heute arbeite ich allein und direkt: Sie sprechen immer
          mit dem, der Ihre Software baut.
        </p>
        <p class="ueber__privat">
          Wenn ich nicht am Rechner sitze, bin ich in den Bergen. 2026 bin ich den Düsseldorf-Marathon gelaufen, der
          Mont Blanc steht noch auf meiner Liste.
        </p>
      </div>
    </div>
  </section>

  <section class="abschnitt" id="projekte" aria-labelledby="projekte-titel">
    <div class="innen raster">
      <div class="abschnitt__kopf">
        <h2 id="projekte-titel">Woran ich gerade arbeite</h2>
      </div>
      <div class="abschnitt__inhalt projekte">
        <article class="projekt">
          <div class="projekt__kopf">
            <h3>Tennismehl GmbH</h3>
            <p class="projekt__kontext">Lieferant für Tennisplatzbeläge, Giebelstadt. Seit 2026.</p>
          </div>
          <div class="projekt__text">
            <p>
              Als Mitgesellschafter verantworte ich die Digitalisierung. Herzstück ist ein eigenes Portal mit
              ERP-Funktionen, das ich Schritt für Schritt ausbaue:
            </p>
            <ul>
              <li>Anfragen von der Website laufen direkt ins Portal statt ins Postfach.</li>
              <li>Bestellt ein Kunde Produkte eines Partners, geht die Bestellung dort automatisch ein.</li>
              <li>Rechnungen entstehen im System und gehen als E-Rechnung raus.</li>
              <li>
                Im Werk bekommt die Absackanlage für 40-kg-Säcke statt reiner Pneumatik eine programmierbare
                Steuerung.
              </li>
            </ul>
          </div>
        </article>

        <article class="projekt">
          <div class="projekt__kopf">
            <h3>Anfrage-Plattform</h3>
            <p class="projekt__kontext">Mandantenfähige Webplattform. 2026.</p>
          </div>
          <div class="projekt__text">
            <p>
              Ein Anfrage-Service und ein Energie-Service werden zu einer Plattform zusammengeführt. Eine gemeinsame
              Codebasis bedient mehrere Mandanten, jeden unter eigener Subdomain. Abläufe im Hintergrund steuert n8n.
            </p>
            <p class="projekt__technik">Next.js, Vercel und n8n</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="abschnitt" id="ablauf" aria-labelledby="ablauf-titel">
    <div class="innen raster">
      <div class="abschnitt__kopf ablauf__kopf">
        <h2 id="ablauf-titel">In drei Schritten zu weniger Büroarbeit</h2>
      </div>
      <ol class="ablauf">
        {
          schritte.map((s) => (
            <li>
              <h3>{s.titel}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="ablauf__zusage">
        <p>
          Ihre alten Programme dürfen bleiben, wenn sie ihren Dienst tun. Ich binde sie an, statt alles neu zu
          machen.
        </p>
        <a class="knopf knopf--voll" href="#kontakt">Erstgespräch vereinbaren</a>
      </div>
    </div>
  </section>

  <Anfrage />
</Base>
